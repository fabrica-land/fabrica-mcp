{
  "name": "@fabrica-land/mcp",
  "version": "0.1.0",
  "description": "MCP server for AI agents to explore tokenized real property on the Fabrica protocol",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "fabrica-mcp": "./dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:ui": "node scripts/build-ui.mjs",
    "prebuild": "npm run build:ui",
    "build": "tsup",
    "prebuild:vercel": "npm run build:ui",
    "build:vercel": "node scripts/build-vercel.mjs",
    "pretypecheck": "npm run build:ui",
    "typecheck": "tsc --noEmit && tsc -p ui --noEmit",
    "predev": "npm run build:ui",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "pretest": "npm run build:ui",
    "test": "vitest run",
    "pretest:watch": "npm run build:ui",
    "test:watch": "vitest",
    "schema:refresh": "node scripts/refresh-api-schema.mjs",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:check": "graphql-codegen --config codegen.ts && git diff --exit-code -- src/clients/generated",
    "knowledge:build": "node scripts/build-knowledge.mjs",
    "regression": "node scripts/regression/run.mjs",
    "knowledge:check": "node scripts/build-knowledge.mjs --check",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "fabrica",
    "real-estate",
    "land",
    "property",
    "rwa",
    "tokenization",
    "ethereum",
    "nft",
    "ai-agents"
  ],
  "author": "Fabrica",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabrica-land/fabrica-mcp.git"
  },
  "homepage": "https://github.com/fabrica-land/fabrica-mcp#readme",
  "bugs": {
    "url": "https://github.com/fabrica-land/fabrica-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "graphql": "^16.13.2",
    "graphql-request": "^7.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-operations": "^6.1.10",
    "@types/node": "^25.5.0",
    "esbuild": "^0.27.7",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
