{
  "name": "@fabrica-land/mcp",
  "version": "0.3.0",
  "private": true,
  "description": "MCP server for AI agents to explore tokenized real property on the Fabrica protocol",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "fabrica-mcp": "./dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:ui": "node scripts/build-ui.mjs",
    "build": "yarn build:ui && tsup",
    "build:vercel": "yarn build:ui && node scripts/build-vercel.mjs",
    "typecheck": "yarn build:ui && tsc --noEmit && tsc -p ui --noEmit",
    "dev": "yarn build:ui && tsup --watch",
    "start": "node dist/index.js",
    "test": "yarn build:ui && vitest run",
    "test:watch": "yarn build:ui && vitest",
    "schema:refresh": "node scripts/refresh-api-schema.mjs",
    "codegen": "node scripts/codegen.mjs",
    "codegen:check": "node scripts/codegen.mjs && git diff --exit-code -- src/clients/generated",
    "knowledge:build": "node scripts/build-knowledge.mjs",
    "regression": "node scripts/regression/run.mjs",
    "knowledge:check": "node scripts/build-knowledge.mjs --check",
    "coverage:build": "node scripts/build-coverage.mjs",
    "registry:publish": "node scripts/registry-publish.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "fabrica",
    "real-estate",
    "land",
    "property",
    "rwa",
    "tokenization",
    "ethereum",
    "nft",
    "ai-agents"
  ],
  "author": "Fabrica",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabrica-land/fabrica-mcp.git"
  },
  "homepage": "https://github.com/fabrica-land/fabrica-mcp#readme",
  "bugs": {
    "url": "https://github.com/fabrica-land/fabrica-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "graphql": "^16.13.2",
    "graphql-request": "^7.4.0",
    "jose": "^6.2.13",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@graphql-codegen/core": "^6.2.2",
    "@graphql-codegen/typescript-operations": "^6.1.10",
    "@types/node": "^25.5.0",
    "esbuild": "^0.28.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@4.12.0",
  "resolutions": {
    "@whatwg-node/promise-helpers": "^1.3.2"
  }
}
