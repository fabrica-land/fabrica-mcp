{
  "fixtures": {
    "ethereum": { "tokenId": "823524884499918313", "slug": "us/nevada/elko-county/elko/apn-00633b008", "listedTokenId": "3484741603659410548", "wallet": "0x378f7af12d594d2e6988b6f7317367e6457b7b0f", "state": "NV", "county": "Elko" },
    "sepolia": { "tokenId": "3498221978189359830", "slug": "us/nevada/clark-county/las-vegas/1165-trout-canyon-road", "listedTokenId": "10470350867971687392", "wallet": "0x51d0cc8d2d1b0ad3a1f4b4bb6c4b8d2fcd8c2dad", "state": "NV", "county": "Clark" }
  },
  "cases": [
    { "id": "search by state code", "tool": "search_properties", "args": { "region": "$state", "limit": 5 }, "expect": "results" },
    { "id": "search by state name", "tool": "search_properties", "args": { "region": "Nevada", "limit": 5 }, "expect": "results" },
    { "id": "search unknown region", "tool": "search_properties", "args": { "region": "ZZ" }, "expect": "contains:not a US state" },
    { "id": "search listings", "tool": "search_properties", "args": { "hasListings": true, "limit": 10 }, "expect": "results" },
    { "id": "search by owner", "tool": "search_properties", "args": { "ownedBy": "$wallet" }, "expect": "results" },
    { "id": "search by county", "tool": "search_properties", "args": { "region": "$state", "county": "$county", "limit": 5 }, "expect": "ok" },
    { "id": "search grouped by state", "tool": "search_properties", "args": { "groupBy": "state" }, "expect": "ok" },
    { "id": "search grouped by county", "tool": "search_properties", "args": { "region": "$state", "groupBy": "county" }, "expect": "ok" },
    { "id": "property by token", "tool": "get_property", "args": { "tokenId": "$tokenId" }, "expect": "contains:propertyChecks" },
    { "id": "property by slug", "tool": "get_property", "args": { "slug": "$slug" }, "expect": "contains:propertyChecks" },
    { "id": "property by URL slug", "tool": "get_property", "args": { "slug": "https://fabrica.land/$slug" }, "expect": "contains:propertyChecks" },
    { "id": "property unknown token", "tool": "get_property", "args": { "tokenId": "12345" }, "expect": "error:No property found with token ID 12345" },
    { "id": "property no args", "tool": "get_property", "args": {}, "expect": "error:Either tokenId or slug" },
    { "id": "map", "tool": "get_property_map", "args": { "tokenId": "$tokenId", "includeCountyBounds": true }, "expect": "contains:FeatureCollection" },
    { "id": "map unknown token", "tool": "get_property_map", "args": { "tokenId": "12345" }, "expect": "error:No property found" },
    { "id": "trust documents", "tool": "get_trust_documents", "args": { "tokenId": "$tokenId" }, "expect": "ok" },
    { "id": "trust documents with text", "tool": "get_trust_documents", "args": { "tokenId": "$tokenId", "includeAgreementText": true }, "expect": "contains:Trust Agreement" },
    { "id": "tax status", "tool": "get_tax_status", "args": { "tokenId": "$tokenId" }, "expect": "contains:status" },
    { "id": "checks by token", "tool": "explain_confidence_score", "args": { "tokenId": "$tokenId" }, "expect": "contains:breakdown" },
    { "id": "checks by value", "tool": "explain_confidence_score", "args": { "score": 75342 }, "expect": "contains:breakdown" },
    { "id": "checks invalid value", "tool": "explain_confidence_score", "args": { "score": 99 }, "expect": "error:not a Property checks encoding" },
    { "id": "borrow quote", "tool": "get_borrow_quote", "args": { "tokenId": "$tokenId" }, "expect": "contains:lendingPool" },
    { "id": "borrow quote listed property", "tool": "get_borrow_quote", "args": { "tokenId": "$listedTokenId" }, "expect": "contains:lendingPool" },
    { "id": "valuation", "tool": "get_valuation", "args": { "tokenId": "$tokenId" }, "expect": "ok" },
    { "id": "valuation unknown token", "tool": "get_valuation", "args": { "tokenId": "12345" }, "expect": "error:No property found" },
    { "id": "activity of a property", "tool": "get_activity", "args": { "tokenId": "$tokenId", "limit": 10 }, "expect": "contains:events" },
    { "id": "activity of a wallet", "tool": "get_activity", "args": { "address": "$wallet", "limit": 5 }, "expect": "contains:events" },
    { "id": "activity no args", "tool": "get_activity", "args": {}, "expect": "contains:every property" },
    { "id": "order book", "tool": "get_order_book", "args": { "tokenId": "$listedTokenId", "status": "all" }, "expect": "contains:listings" },
    { "id": "property image", "tool": "get_property_image", "args": { "tokenId": "$tokenId", "width": 400, "height": 300 }, "expect": "image" },
    { "id": "portfolio", "tool": "get_portfolio", "args": { "address": "$wallet" }, "expect": "contains:portfolioValue" },
    { "id": "portfolio empty wallet", "tool": "get_portfolio", "args": { "address": "0x000000000000000000000000000000000000dEaD" }, "expect": "contains:portfolioValue" },
    { "id": "portfolio not an address", "tool": "get_portfolio", "args": { "address": "not-an-address" }, "expect": "contains:No Fabrica activity" },
    { "id": "portfolio image", "tool": "get_portfolio_image", "args": { "address": "$wallet" }, "expect": "image" },
    { "id": "lending market", "tool": "get_lending_market", "args": {}, "expect": "contains:poolStats" },
    { "id": "lending market active", "tool": "get_lending_market", "args": { "status": "active", "limit": 5 }, "expect": "contains:summary" },
    { "id": "lending market repaid since", "tool": "get_lending_market", "args": { "status": "repaid", "since": "2026-01-01", "limit": 3 }, "expect": "contains:summary" },
    { "id": "protocol stats", "tool": "get_protocol_stats", "args": {}, "expect": "contains:totalTokenized" },
    { "id": "ask about the trust", "tool": "ask_fabrica", "args": { "question": "How does the Fabrica trust work and who is the trustee?" }, "expect": "contains:fabrica-trust" },
    { "id": "ask for the contract code", "tool": "ask_fabrica", "args": { "question": "Where is the contract code?" }, "expect": "contains:build-on-fabrica" },
    { "id": "ask the help center only", "tool": "ask_fabrica", "args": { "question": "How do I add my property?", "source": "help", "maxPassages": 2 }, "expect": "contains:help.fabrica.land" },
    { "id": "find parcel by address", "tool": "find_parcel", "args": { "query": "1707 Jones St, San Francisco, CA" }, "expect": "contains:match" },
    { "id": "find parcel unknown number", "tool": "find_parcel", "args": { "query": "APN 123-456-789", "state": "NV" }, "expect": "contains:\"match\": \"none\"" },
    { "id": "find parcel garbage", "tool": "find_parcel", "args": { "query": "asdfghjkl" }, "expect": "contains:\"match\": \"none\"" },
    { "id": "contact support", "tool": "contact_support", "args": { "summary": "My listing does not show on the marketplace", "topic": "buying_selling" }, "expect": "contains:mailto" }
  ]
}
